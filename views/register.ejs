<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <link rel="stylesheet" href="./css/register.css">
</head>
<body>
    
    <div class="mainContainer">
        <div class="container">
            <h1 class="title <% if(locals.error){%>registerError<%}%>"><% if(locals.error){ %> <%= error %> <% } else{ %>Register <% } %></h1>

            <form class="form" action="/registeration" method="POST">
                <input class="input name" placeholder="USERNAME" type="text" name="username">
                <input class="input email" placeholder="EMAIL" type="email" name="email">
                <input class="input pass" placeholder="PASSWORD" type="password" name="password">
                <input class="input button" value="Register" type="submit">

                <p class="text">Already registered? <a class="anchor" href="/login">Login</a></p>
            </form>
        </div>
    </div>
    

</body>
</html>